{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mario-game",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",

  // Game tĩnh (HTML/CSS/JS) được phục vụ trực tiếp từ thư mục public/.
  // Các đường dẫn /api/* sẽ chạy vào Worker (src/worker.js) trước.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mario-game-db",
      // THAY bằng ID thật sau khi chạy: npx wrangler d1 create mario-game-db
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
